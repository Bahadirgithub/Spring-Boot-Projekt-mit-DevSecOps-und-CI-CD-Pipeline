        <mxCell id="note_p2_bewertung" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#D4B106;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fontStyle=0" value="&lt;strong&gt;Notiz:&lt;/strong&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;8&quot;&gt; Bewertung &lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;21&quot;&gt;läuft über ein &lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;36&quot;&gt;eigenes Pop-up &lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;51&quot;&gt;(&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;BewertungsPopup&lt;/code&gt;&lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;68&quot;&gt;), analog zu &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;BewerbungsPopup&lt;/code&gt;&lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;83&quot;&gt; — so &lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;105&quot;&gt;bleibt die Ideenliste &lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;127&quot;&gt;übersichtlich, auch wenn eine &lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;157&quot;&gt;Idee &lt;br&gt;mehrere Bewertungen hat. Klick auf &lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;197&quot;&gt;eine Idee öffnet das Pop-up mit &lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;229&quot;&gt;Sterne-Auswahl, Kommentarfeld und &lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;263&quot;&gt;der Liste bisheriger Bewertungen zu &lt;/span&gt;&lt;span class=&quot;_animating_6ta1u_10&quot; data-newtext-seq=&quot;299&quot;&gt;dieser Idee.&lt;/span&gt;" vertex="1">
          <mxGeometry height="93" width="487.5" x="5398.75" y="2066" as="geometry" />
        </mxCell>
        <mxCell id="note_p2_bewerbung" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#D4B106;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fontStyle=0" value="Notiz: Drei User Stories teilen sich hier die gleiche Entity (Bewerbung), deshalb gibt es nur EIN Control mit mehreren Methoden statt drei einzelne Controls. BewerbungsPopup ist das Pop-up-Fenster zum Bewerben selbst (Anschreiben, Upload). BewerbungsUebersichtView zeigt je nach Rolle entweder &#39;meine eigenen Bewerbungen&#39; (Student) oder &#39;eingegangene Bewerbungen&#39; (Gruender) - eine View, zwei Sichten." vertex="1">
          <mxGeometry height="78" width="842" x="4933.5" y="4212" as="geometry" />
        </mxCell>
        <mxCell id="note_p2_ki" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#D4B106;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fontStyle=0" value="Notiz: KIStrategie wäre die Pflicht-Schnittstelle, damit man das KI-Modell (aktuell Llama) jederzeit gegen ein anderes tauschen kann, ohne das Control selbst ändern zu müssen." vertex="1">
          <mxGeometry height="62" width="560" x="6757" y="3475" as="geometry" />
        </mxCell>
        <mxCell id="note_p2_dashboard" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#D4B106;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fontStyle=0" value="Notiz: Kein eigenes DTO nötig, StatistikControl greift direkt auf bestehende Repositories &lt;br&gt;(z.B. BewerbungRepository, GruendungsideeRepository) zu und zählt die Zahlen &lt;br&gt;selbst zusammen." vertex="1">
          <mxGeometry height="80" width="485" x="6335.5" y="1616" as="geometry" />
        </mxCell>
        <mxCell id="note_p2_moderation" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#D4B106;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fontStyle=0" value="Weil es bisher kein &#39;Melden&#39; im System gibt. Melden (durch User) und Sperren (durch Admin) sind zwei Schritte im selben Vorgang, deshalb ein gemeinsames Control statt zwei getrennte." vertex="1">
          <mxGeometry height="58" width="595.5" x="5768.25" y="721" as="geometry" />
        </mxCell>
        <mxCell id="note_p2_matching" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#D4B106;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fontStyle=0" value="Notiz: Kein eigenes DTO nötig - MatchingControl nutzt einfach StudentDTO.getSkills() und GruendungsideeDTO.getGesuchteSkills() und vergleicht die beiden Listen (z.B. retainAll). &lt;br&gt;Es benötigt keine eigene View, die Vorschläge werden direkt in die bestehende &lt;br&gt;Seite (&lt;span style=&quot;text-align: center;&quot;&gt;BewerbungsUebersichtView&lt;/span&gt;) eingebaut es ist also eine Filter Funktion." vertex="1">
          <mxGeometry height="90" width="537" x="-1242.5" y="2866" as="geometry" />
        </mxCell>
        <mxCell id="H4mO9qsZELtN6IUfVHNf-20" edge="1" parent="1" source="cls_p2_bewerbunguebersichtview" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=1;entryDx=0;entryDy=0;endArrow=none;endFill=0;" target="txt_p2_matchingcontrol">
